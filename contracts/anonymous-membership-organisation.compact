pragma language_version >= 0.23;

import CompactStandardLibrary;

export ledger admin: Bytes<32>;
export ledger memberCommitments: Map<Bytes<32>, Boolean>; // true if active, false if revoked
export ledger verifiedMembers: Map<Bytes<32>, Boolean>; // stores nullifiers to prevent double verification
export ledger verificationCount: Counter;
export ledger memberCount: Counter;

constructor(adminKey: Bytes<32>) {
    admin = disclose(adminKey);
}

struct MembershipCredential {
    secret: Bytes<32>,
    membershipId: Uint<32>
}

// Witness provided by the member
witness credential(): MembershipCredential;

// Admin registers a member's commitment
export circuit registerMembership(commitment: Bytes<32>): [] {
    assert(admin == disclose(ownPublicKey()).bytes, "Only admin can register members");
    
    // Check if commitment is already registered and currently active
    const isRegistered = memberCommitments.member(disclose(commitment));
    if (isRegistered) {
        assert(!memberCommitments.lookup(disclose(commitment)), "Member already registered and active");
    }
    
    memberCommitments.insert(disclose(commitment), true);
    memberCount.increment(1);
}

// Admin revokes a member's commitment
export circuit revokeMembership(commitment: Bytes<32>): [] {
    assert(admin == disclose(ownPublicKey()).bytes, "Only admin can revoke members");
    
    // Member must exist in commitments map and currently be active
    assert(memberCommitments.member(disclose(commitment)), "Member commitment not found");
    assert(memberCommitments.lookup(disclose(commitment)), "Member is already revoked");
    
    memberCommitments.insert(disclose(commitment), false);
    memberCount.decrement(1);
}

// Admin transfers administrative authority to a new key
export circuit transferAdmin(newAdmin: Bytes<32>): [] {
    assert(admin == disclose(ownPublicKey()).bytes, "Only current admin can transfer administration");
    admin = disclose(newAdmin);
}

struct ActionNullifier {
    secret: Bytes<32>,
    actionId: Bytes<32>
}

// Any user can anonymously verify their membership using their private credential
// for a specific action (e.g., voting on a proposal, accessing a specific resource).
export circuit verifyMembership(actionId: Bytes<32>): [] {
    const commitment = disclose(persistentHash<MembershipCredential>(credential()));
    
    // Member must be registered AND actively valid (not revoked)
    assert(memberCommitments.member(commitment), "Membership commitment not found");
    assert(memberCommitments.lookup(commitment), "Membership has been revoked");
    
    // Create a unique nullifier derived from the secret AND the actionId.
    // This prevents double-verification for the SAME action, but allows the 
    // member to verify anonymously for DIFFERENT actions without correlation.
    const nullifierData = ActionNullifier { 
        secret: credential().secret, 
        actionId: actionId 
    };
    const nullifier = disclose(persistentHash<ActionNullifier>(nullifierData));
    
    assert(!verifiedMembers.member(nullifier), "Membership already verified for this action");
    
    // Record verification and increment counter
    verifiedMembers.insert(nullifier, true);
    verificationCount.increment(1);
}
